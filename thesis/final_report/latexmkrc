# Build the report with `latexmk` from final_report/: temporary files go to build/,
# the finished PDF is copied to final_report/main.pdf.
@default_files = ('main.tex');
$pdf_mode = 1;
$out_dir = 'build';
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
ensure_path('BIBINPUTS', '..');   # bibtex runs inside build/; the .bib lives one level up
$success_cmd = 'cp build/main.pdf main.pdf';
# Reproducible PDF: pdfTeX takes its timestamps and document ID from this fixed epoch
# (2 October 2026, 23:59:55 SAST, the final build), so every rebuild is byte-identical.
$ENV{SOURCE_DATE_EPOCH} = '1790978395';
$ENV{FORCE_SOURCE_DATE} = '1';
